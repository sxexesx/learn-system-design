      "version": 188,
      "versionNonce": 100237304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780075250650,
      "link": null,
      "locked": false,
      "text": "API:\n- ListPost (params, type)\n- GetPost (params)\n\n- AddFriend(params)\n- DeleteFriend(params)\n\n- UploadMedia(params)\n- CreatePost(params)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
