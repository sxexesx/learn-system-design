    {
      "id": "_XGRzEHzTU_enY5lvKK6h",
      "type": "text",
      "x": 309.498146329272,
      "y": 513.4848342688866,
      "width": 393.110164770344,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
